# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- 密钥：.env 绝不能提交 GitHub ----
.env
.env.*
!.env.example

# ---- 工作台运行时数据（不入库）----
market_data/
data_cache/*
!data_cache/.gitkeep

# ---- 测试 / 缓存 / 日志 ----
.pytest_cache/
.coverage
htmlcov/
*.log

# ---- 生成的报告（保留 .gitkeep 与既有共识/汇总文档）----
reports/*.md
!reports/.gitkeep
!reports/four_ai_consensus_v1.2.md

# ---- 归档历史模块内的运行产物（本地保留，不入库）----
_archive_legacy/**/*.lock
_archive_legacy/**/*.sqlite
_archive_legacy/**/*.sqlite3
_archive_legacy/**/*.db
_archive_legacy/**/cache/**
_archive_legacy/**/evolution_history.jsonl
