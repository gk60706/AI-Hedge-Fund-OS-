{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investment_decision.schema.json",
  "title": "AI Investment Committee Decision",
  "description": "A research and paper-trading decision produced by the investment committee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "task_id",
    "symbol",
    "market",
    "decision",
    "rationale",
    "risk_level",
    "created_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "consensus_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "symbol": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "market": {
      "type": "string",
      "enum": [
        "CN",
        "HK",
        "US",
        "OTHER"
      ]
    },
    "company_name": {
      "type": "string",
      "maxLength": 300
    },
    "decision": {
      "type": "string",
      "enum": [
        "strong_buy",
        "buy",
        "watch",
        "hold",
        "reduce",
        "avoid",
        "insufficient_data"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "very_high",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "target_price": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "entry_price_low": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "entry_price_high": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "stop_loss_price": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "position_suggestion": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "investment_horizon": {
      "type": "string",
      "enum": [
        "intraday",
        "short_term",
        "medium_term",
        "long_term",
        "undetermined"
      ]
    },
    "key_catalysts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "key_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "paper_trade_only": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
