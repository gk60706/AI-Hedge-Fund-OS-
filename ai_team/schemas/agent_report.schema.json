{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_report.schema.json",
  "title": "AI Team Agent Report",
  "description": "A structured report produced by an AI team agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "task_id",
    "agent_role",
    "status",
    "summary",
    "created_at"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_role": {
      "type": "string",
      "enum": [
        "CIO",
        "INTELLIGENCE",
        "ANALYST",
        "RISK_MANAGER",
        "RESEARCHER",
        "GENERAL"
      ]
    },
    "agent_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed",
        "failed",
        "rejected"
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "market": {
      "type": "string",
      "enum": [
        "CN",
        "HK",
        "US",
        "OTHER"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "conclusion": {
      "type": "string",
      "maxLength": 20000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "importance": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 5000
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "data_period": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The period covered by the source data, e.g. 2026-Q2, 2026-01-01/2026-06-30."
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official",
              "company_filing",
              "government",
              "exchange",
              "academic",
              "financial_data",
              "news_media",
              "industry_research",
              "other"
            ],
            "description": "Classification of the evidence source."
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ],
            "description": "Whether the source and its evidence have been independently verified."
          },
          "verification_note": {
            "type": "string",
            "maxLength": 1000,
            "description": "Reason or limitation when evidence is unverified."
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
