{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_task.schema.json",
  "title": "AI Team Agent Task",
  "description": "A task assigned to an AI team agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_type",
    "title",
    "description",
    "status",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_type": {
      "type": "string",
      "enum": [
        "research",
        "market_analysis",
        "fundamental_analysis",
        "technical_analysis",
        "risk_analysis",
        "news_analysis",
        "cross_validation",
        "debate",
        "consensus",
        "investment_decision",
        "general"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "assigned",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5
    },
    "assigned_role": {
      "type": "string",
      "enum": [
        "CIO",
        "INTELLIGENCE",
        "ANALYST",
        "RISK_MANAGER",
        "RESEARCHER",
        "GENERAL"
      ]
    },
    "assigned_agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "symbol": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "market": {
      "type": "string",
      "enum": [
        "CN",
        "HK",
        "US",
        "OTHER"
      ]
    },
    "input_data": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "metadata": {
      "type": "object"
    }
  }
}
