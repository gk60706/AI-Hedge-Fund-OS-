OPENAI_API_KEY=replace_with_a_new_key
OPENAI_MODEL=gpt-5.5

APP_NAME=AI Hedge Fund OS
APP_ENV=development
LOG_LEVEL=INFO


# ---- V3.9.1 统一研究引擎 ----
CACHE_DIR=data_cache
ALPHA_LIBRARY_DIR=alpha_library
REPORT_DIR=reports
EXPERIMENT_DIR=experiments
RANDOM_SEED=42
COMMISSION_RATE=0.0003
STAMP_DUTY_RATE=0.0005
SLIPPAGE_RATE=0.0005
MAX_SINGLE_WEIGHT=0.20
MAX_TOTAL_EXPOSURE=0.95
MIN_CASH=0.05

# ---- V3.10 多 AI API 适配器（ai_team/adapters.py）----
# ChatGPT（OpenAI 兼容协议）
OPENAI_BASE_URL=https://api.openai.com/v1
# Grok（xAI，兼容 OpenAI chat/completions；XAI_MODEL 必填，例如 xAI 控制台中的模型名）
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=
# Hark（无公开文档 API；如需接入请自建网关，三项都填才会启用，否则该席位走人工模式）
HARK_API_KEY=
HARK_BASE_URL=
HARK_MODEL=
# ---- V3.10 自定义大模型（configs/ai_providers.yaml）----
# key 统一命名为 AIH_<ID>_API_KEY，其中 <ID> 对应 YAML 里 provider_id 的大写形式
# 没填 key 的厂商只会被标为 skipped，不会让整次运行报错
# AIH_<ID>_MODEL / AIH_<ID>_BASE_URL 是可选项，留空就用 YAML 里的默认值

# DeepSeek
AIH_DEEPSEEK_API_KEY=
# AIH_DEEPSEEK_MODEL=deepseek-chat

# Kimi（Moonshot）
AIH_MOONSHOT_API_KEY=
# AIH_MOONSHOT_MODEL=kimi-k2-turbo-preview

# Qwen（阿里云百炼 / DashScope）
AIH_DASHSCOPE_API_KEY=
# AIH_DASHSCOPE_MODEL=qwen-plus

# 智谱 GLM
AIH_ZHIPU_API_KEY=
# AIH_ZHIPU_MODEL=glm-4.5

# MiniMax
AIH_MINIMAX_API_KEY=
# AIH_MINIMAX_MODEL=MiniMax-M2

# OpenAI：YAML 里的 openai 项读的是 AIH_OPENAI_API_KEY，不是内置席位用的变量
AIH_OPENAI_API_KEY=
# AIH_OPENAI_MODEL=gpt-4o-mini

# 自建网关（可选；YAML 里默认 enabled: false）
# HARK_BASE_URL=http://127.0.0.1:8000/v1
# AIH_HARK_API_KEY=
